{
  "name": "@revenexx/consent-manager-nuxt",
  "version": "0.0.0",
  "description": "Nuxt module for the revenexx Consent Manager: an SSR-rendered consent banner without a third-party script, the rvx_consent cookie, Google Consent Mode v2, <ConsentGate> content blocking and a ConsentProvider for @nuxt/scripts.",
  "keywords": [
    "nuxt",
    "nuxt-module",
    "consent",
    "cookie-banner",
    "gdpr",
    "tdddg",
    "consent-mode",
    "nuxt-scripts",
    "revenexx"
  ],
  "homepage": "https://github.com/revenexx/consent-manager-nuxt#readme",
  "bugs": {
    "url": "https://github.com/revenexx/consent-manager-nuxt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revenexx/consent-manager-nuxt.git"
  },
  "license": "MIT",
  "author": "revenexx",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "nuxt-module-build prepare && vue-tsc --noEmit && vue-tsc --noEmit -p src/runtime/server",
    "prepack": "nuxt-module-build prepare && nuxt-module-build build",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "defu": "^6.1.4",
    "h3": "^1.15.0"
  },
  "peerDependencies": {
    "@nuxt/scripts": "^1.0.0",
    "nuxt": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/scripts": {
      "optional": false
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@nuxt/eslint-config": "^1.9.0",
    "@nuxt/module-builder": "^1.0.2",
    "@nuxt/schema": "^4.2.0",
    "@nuxt/scripts": "^1.3.12",
    "@nuxt/test-utils": "^3.19.2",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.36.0",
    "happy-dom": "^18.0.1",
    "nuxt": "^4.2.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "vue": "^3.5.22",
    "vue-tsc": "^3.1.0"
  },
  "packageManager": "pnpm@10.23.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}
